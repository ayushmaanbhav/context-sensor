{
  "EventListeners": [
    {
      "Type": "MouseEventListener",
      "Enabled": true
    }
  ],
  "OutputWriters": [
    {
      "Type": "ConsoleOutputWriter",
      "Enabled": true,
      "Format": "csv",
      "Destination": "console"
    },
    {
      "Type": "FileOutputWriter",
      "Enabled": true,
      "Format": "json",
      "Destination": "C:\\ProgramData\\ContextSensor\\data\\events.log",
      "FlushInterval": 10
    }
  ],
  "Storage": {
    "DataDirectory": "C:\\ProgramData\\ContextSensor\\data"
  },
  "Logging": {
    "LogFilePath": "C:\\ProgramData\\ContextSensor\\logs\\contextsensor.log",
    "MinimumLevel": "Information"
  },
  "AppSettings": {
    "ApplicationName": "ContextSensor",
    "Version": "1.0.0"
  }
}
